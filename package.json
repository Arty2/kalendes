{
  "name": "kalendes",
  "private": true,
  "version": "0.0.73",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "quick": "npm run typecheck && vitest run",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "ical-expander": "^3.1.0",
    "ical.js": "^2.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.13.6",
    "@vercel/node": "^13.0.2",
    "happy-dom": "^20.14.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "ical-expander": {
      "ical.js": "$ical.js"
    },
    "@vercel/node": {
      "undici": "^6.28.1",
